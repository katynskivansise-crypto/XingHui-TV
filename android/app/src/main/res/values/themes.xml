<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 主主题。逐项对齐原版 leanback/res/values/styles.xml 的 BaseTheme：
         原版 BaseTheme parent=Theme.MaterialComponents.Light.NoActionBar，
         这里 parent 换成原生全屏主题（本工程不引 MaterialComponents），其余 item 保持一致。

         最容易漏的是 windowTranslucentStatus / windowTranslucentNavigation 两条：
         原版全屏并不是只靠 windowFullscreen，而是这两条让 DecorView 不再 fitsSystemWindows，
         内容才真正从屏幕 (0,0) 起算、铺满整块屏。少了它们，部分 ROM（斐讯 T1 这种）
         会保留一条 insets，播放页画面四周就露出一圈窗口背景（浅色时看着就是"白条"）。 -->
    <style name="Theme.TVBox" parent="android:Theme.Black.NoTitleBar.Fullscreen">
        <item name="android:windowFullscreen">true</item>
        <!-- 原版 BaseTheme 是 android:windowBackground=@null（什么都不画），不是铺一层不透明黑。
             窗口背景这一层会被系统当成「整窗不透明」，SurfaceView 的挖洞一旦被算错，
             露出来的就是这层黑 —— 真机上表现就是按菜单键画面全黑、声音照走。
             黑改由根布局自己画（视觉完全一样），窗口背景留空。 -->
        <!-- ★窗口背景必须是 @null：不透明窗口 = 整窗不透明 surface，
             SurfaceView 的挖洞一旦重算失败，按菜单键就是整屏黑、声音照走。
             黑由根布局自绘（外观完全一致），窗口这一层留空。
             注意 colorBackground 也要跟着空，否则框架会拿它当窗口底色。 -->
        <item name="android:windowBackground">@null</item>
        <item name="android:colorBackground">@null</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
