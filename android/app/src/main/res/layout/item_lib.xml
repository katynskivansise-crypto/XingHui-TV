<?xml version="1.0" encoding="utf-8"?>
<!-- 历史/收藏卡片：结构照原版 leanback/res/layout/adapter_vod.xml
     （海报铺满整卡 + 片名压在底部 + 备注压在片名上方 + 删除整卡遮罩）。
     卡片的宽高由 LibAdapter 按原版 HistoryAdapter.setLayoutSize() 算好传进来，
     所以根布局不再写死尺寸。 -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="150dp"
    android:layout_height="200dp"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <ImageView
        android:id="@+id/libImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#16161C"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/libName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@drawable/bg_vod_name"
        android:ellipsize="marquee"
        android:gravity="center"
        android:padding="6dp"
        android:singleLine="true"
        android:textColor="@android:color/white"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/libInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/libName"
        android:background="@drawable/bg_remark_tag"
        android:ellipsize="marquee"
        android:padding="4dp"
        android:singleLine="true"
        android:textColor="@android:color/white"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/libDel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#8C000000"
        android:gravity="center"
        android:singleLine="true"
        android:text="删除"
        android:textColor="@android:color/white"
        android:textSize="22sp"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/item_focus"
        android:duplicateParentState="true" />

</RelativeLayout>
