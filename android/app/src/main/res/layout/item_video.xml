<?xml version="1.0" encoding="utf-8"?>
<!-- 影片网格项：海报 + 片名 + 备注 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="200dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="6dp"
    android:focusable="true"
    android:clickable="true"
    android:background="@drawable/item_focus">

    <!-- 海报 + 左下角集数/备注角标（对齐原版「全30集」绿标压在海报上） -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="250dp">

        <ImageView
            android:id="@+id/vodImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="#16161C" />

        <TextView
            android:id="@+id/vodRemarks"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="6dp"
            android:background="@drawable/bg_remark_tag"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

    </FrameLayout>

    <TextView
        android:id="@+id/vodName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:paddingTop="6dp"
        android:textColor="#FFFFFF"
        android:textSize="15sp" />

</LinearLayout>
