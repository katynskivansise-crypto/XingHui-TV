<?xml version="1.0" encoding="utf-8"?>
<!-- ★单窗口宿主：详情层与播放层是同一个 Activity 里的两个 View 层。
     画面层是一块 SurfaceView，从进详情页那一刻起就存在，直到退出 App 都不销毁；
     EXO 与 mpv 轮流接管这块面（media3 setVideoSurfaceView / clearVideoSurfaceView）。

     Z 序（自下而上，SurfaceView 的 surface 天然在窗口 surface 之下，普通 View 一律盖在它上面）：
        videoFrame   画面容器（AspectRatioFrameLayout，resize_mode=fit）
        detailLayer  详情层
        playLayer    播放层（转圈/顶栏/控制条，根背景必须透明，否则会盖住画面）

     三种形态只改 videoFrame 的 LayoutParams：
        小窗   = 400dp x 225dp，摆在详情页 playerBox 的位置
        全屏预览（详情页里点小窗）= MATCH_PARENT
        播放   = MATCH_PARENT，同时 detailLayer GONE、playLayer VISIBLE

     换内核时会黑一下：setRender 重建内部 surface —— 原版行为，不做规避。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/hostRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <!-- ★壁纸层：照原版 contextWall 的做法 —— 它是布局里的一块全屏 ImageView，
         不是 window 背景。原版 VideoActivity 里就是 setImageDrawable + 显隐控制。
         我们之前只设 window.setBackgroundDrawable，在单 Activity + 这块 decor 上不稳，
         结果就是"有时候有壁纸、有时候纯黑"。放一层实打实的 View 最不容易再丢。 -->
    <ImageView
        android:id="@+id/contextWall"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <!-- ★画面层就是原版的 mBinding.video：小窗 400x225，全屏时把容器撑到 MATCH_PARENT。
         切换方式与原版一致（VideoActivity.java 1511-1523）：
           mBinding.video.setLayoutParams(new LayoutParams(MATCH_PARENT, MATCH_PARENT));
         关键不在容器，而在于把它交给引擎的方式必须是 setVideoSurfaceView(View) ——
         这样 media3 才会挂 SurfaceHolder.Callback、在 surface 尺寸变化时自己调 setVideoSurfaceSize。
         我们之前用的是 setVideoSurface(holder.surface)，裸 Surface 没有这个监听，
         尺寸一变解码器就不知道 → 画面停住、声音还在。 -->
    <androidx.media3.ui.AspectRatioFrameLayout
        android:id="@+id/videoFrame"
        android:layout_width="400dp"
        android:layout_height="225dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:background="@android:color/black"
        app:resize_mode="fit">

        <!-- ★画面层结构（依据官方原文 + 两版原项目布局，不是经验）：
             1) 原版 5.0.8 / 5.6.0 的 activity_video、activity_live、activity_cast 三个播放页
                都是"EXO 一个 View + IJK 一个 View"并存，同一时刻只显示一个 —— 本布局同构。
             2) media3 官方 keep_content_on_player_reset 默认 false，原项目 Player.Vod 也是 false。
             3) PlayerManager 原注释："A Surface used by a CPU renderer stays connected after decoder
                release. A different player needs a new Surface before its GPU/codec can connect."
                且 resetVideoSurface 只在换内核时为 true —— 尺寸变化从不重建 surface。 -->

        <!-- 一块输出面，EXO 与 mpv 轮流接管 —— 与 5.6.0 PlaybackActivity 同构：
             它只有一个 getExoView()，EXO 与 mpv 都是 media3 Player 的实现，
             换内核就是 setPlayer(null) → setRender(目标) → setPlayer(新内核)。
             surface 的生死由 media3 的 setVideoSurfaceView / clearVideoSurfaceView 统一管理，
             双方不会各自挂一套 SurfaceHolder.Callback 互相踩。
             换内核时会黑一下：setRender 重建内部 surface，这是原版行为。 -->
        <SurfaceView
            android:id="@+id/videoSurface"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- PlayerView 已移除：surface_type=none 之后它不提供任何画面，只剩一层可能遮挡的空壳。
             它原本承担的三件事现在各有归属：
               resize_mode   → 外层 AspectRatioFrameLayout（VideoHost.resizeMode 直接操作它）
               use_controller→ 我们自己的 activity_play_layer 控制条
               shutter        → 场景不存在了（没有 PlayerView 就没有 shutter） -->

        <androidx.media3.ui.SubtitleView
            android:id="@+id/subtitleView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- ★小窗加载圈 —— 位置逐条对齐原版 5.0.8 `activity_video.xml` 第 12 行：
             `<include android:id="@id/progress" layout_width="fill_parent"
              layout_height="fill_parent" layout="@layout/view_progress" />`
             它是 **`@id/video` 这个 400x225 容器的子 View**，不是全屏层。
             所以原版起播时圈出现在**小窗内部**，外面照常显示详情（`video` 只是被
             `ProgressLayout` 一并 INVISIBLE 到出画面为止）。

             我们上一版把圈加到了 hostRoot 上（全屏），位置错了 —— 已撤掉，改成这里。 -->
        <!-- ★错误块 —— 逐条复刻 5.0.8 `res/layout/view_widget_vod.xml` 第 8-11 行：
             原版是 `@id/video`（400x225 容器）内 `@id/widget`（include view_widget_vod）里的
             `LinearLayout android:id="@id/error"`：
               · layout_gravity="center"、gravity="center"、orientation="vertical"
               · background="@drawable/shape_widget"（#66000000 + 8dip 圆角 + 16dip padding）
               · 56.0dip 的 AppCompatImageView，src="@drawable/ic_widget_error"
               · 16.0sp / white / center 的 TextView，id=@id/text
             显隐由 `showError()` / `hideError()` 控制（5.6.0 VideoActivity:3450 / :3456），
             时机：`onError(msg)` → `showError(msg)`；`showProgress()` 里 `hideError()`。 -->
        <LinearLayout
            android:id="@+id/inlineError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/shape_widget"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_widget_error" />

            <TextView
                android:id="@+id/inlineErrorText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="16sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/inlineProgress"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <!-- 原版 view_progress.xml：CircularProgressIndicator 居中、indeterminate、白色 -->
            <ProgressBar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminateTint="@android:color/white" />

            <!-- 逐条对齐 5.0.8 `res/layout/view_progress.xml` 第 5 行：
                 <MaterialTextView android:textSize="16.0sp" android:textColor="@color/white"
                   android:layout_gravity="center" android:id="@id/traffic"
                   android:visibility="gone" android:layout_width="wrap_content"
                   android:layout_height="wrap_content" android:layout_marginTop="40.0dip" />
                 ★注意：原版**没有** android:text 属性。这段文字是 `Traffic.setSpeed(view)` 每秒写进去的
                   网速（"123 KB/s" / "1.2 MB/s"），不是"加载中"提示。
                   我之前写死成 text="加载中"、marginTop 改成 56dp，两处都是自创，已改回。 -->
            <TextView
                android:id="@+id/inlineProgressText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="40dp"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:visibility="gone" />
        </FrameLayout>
    </androidx.media3.ui.AspectRatioFrameLayout>

    <FrameLayout
        android:id="@+id/detailLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent" />

    <FrameLayout
        android:id="@+id/playLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:alpha="0"
        android:descendantFocusability="blocksDescendants" />

</FrameLayout>
