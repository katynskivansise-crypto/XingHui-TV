<?xml version="1.0" encoding="utf-8"?>
<!-- 详情页：海报 + 信息 + 简介 + 线路/集数列表 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000"
    android:padding="24dp">

    <TextView
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:focusable="true"
        android:clickable="true"
        android:background="@drawable/selector_tv_btn"
        android:text="← 返回" />

    <TextView
        android:id="@+id/detailName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:text="影片详情" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- 对齐原版 VideoActivity：这里是播放器小窗，点它进全屏。
             海报压在同一格里，起播前显示海报，起播后被播放器覆盖。 -->
        <FrameLayout
            android:id="@+id/playerBox"
            android:layout_width="0dp"
            android:layout_height="270dp"
            android:layout_weight="1.2"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:background="#1A1A1A">

            <ImageView
                android:id="@+id/detailImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />

            <androidx.media3.ui.PlayerView
                android:id="@+id/inlinePlayer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                app:use_controller="false" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingLeft="16dp">

            <TextView
                android:id="@+id/detailInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="8dp"
                android:textColor="#B0FFFFFF"
                android:textSize="15sp"
                android:text="年份 · 地区 · 备注" />

            <TextView
                android:id="@+id/detailDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="6"
                android:ellipsize="end"
                android:textColor="#CCFFFFFF"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp"
                android:text="简介" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="14dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/btnDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:padding="10dp"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:focusable="true"
            android:clickable="true"
            android:background="@drawable/selector_tv_btn"
            android:drawableStart="@drawable/ic_detail_desc"
            android:drawableTint="#FFFFFF"
            android:drawablePadding="6dp"
            android:text="简介" />

        <TextView
            android:id="@+id/btnFav"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:padding="10dp"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:focusable="true"
            android:clickable="true"
            android:background="@drawable/selector_tv_btn"
            android:drawableStart="@drawable/ic_detail_keep_off"
            android:drawableTint="#FFFFFF"
            android:drawablePadding="6dp"
            android:text="收藏" />

        <TextView
            android:id="@+id/btnSource"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:focusable="true"
            android:clickable="true"
            android:background="@drawable/selector_tv_btn"
            android:drawableStart="@drawable/ic_detail_change"
            android:drawableTint="#FFFFFF"
            android:drawablePadding="6dp"
            android:text="换源" />

    </LinearLayout>

    <!-- 线路名（原版这一行就是「瓜子视频」本身，黄色） -->
    <TextView
        android:id="@+id/detailListLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="12dp"
        android:paddingBottom="6dp"
        android:textColor="#FFCC00"
        android:textSize="16sp"
        android:text="播放线路" />

    <!-- 倒序 + 分段（对齐原版「倒序 → 1-40 41-80 81-102」） -->
    <LinearLayout
        android:id="@+id/groupRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/btnOrder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:focusable="true"
            android:clickable="true"
            android:background="@drawable/selector_tv_btn"
            android:text="倒序" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="16dp"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:text="→" />

        <LinearLayout
            android:id="@+id/groupItems"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/detailList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false" />

</LinearLayout>
