<?xml version="1.0" encoding="utf-8"?>
<!-- 主界面（对齐原版 TVBox 结构）：
     一级 = 站点名 + 点播/直播/搜索/收藏/历史 五个入口 + 更新推荐
     二级（点播）= 横向分类 tab + 影片网格 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/transparent">

    <!-- 顶部标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/ic_logo"
            android:scaleType="fitCenter"
            android:focusable="false" />

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="260dp"
            android:paddingStart="2dp"
            android:paddingEnd="6dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textColor="@android:color/white"
            android:textSize="24sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:focusable="true"
            android:clickable="true"
            android:background="@drawable/selector_tv_btn"
            android:text="@string/app_name" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textColor="#B0FFFFFF"
            android:textSize="24sp"
            android:text="--:--" />

        <TextView
            android:id="@+id/btnSites"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:focusable="true"
            android:clickable="true"
            android:background="@drawable/selector_tv_btn"
            android:text="站点" />

        <TextView
            android:id="@+id/btnSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:focusable="true"
            android:clickable="true"
            android:background="@drawable/selector_tv_btn"
            android:text="设置" />

    </LinearLayout>

    <!-- 一级入口行（对齐原版：五个大入口） -->
    <LinearLayout
        android:id="@+id/entryRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="44dp"
        android:paddingEnd="24dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:id="@+id/btnVod"
            android:layout_width="110dp"
            android:layout_height="118dp"
            android:layout_marginEnd="26dp"
            android:gravity="center"
            android:orientation="vertical"
            android:focusable="true"
            android:clickable="true"
            android:background="@drawable/selector_tv_btn">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_home_vod"
                android:focusable="false" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:text="点播" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnLive"
            android:layout_width="110dp"
            android:layout_height="118dp"
            android:layout_marginEnd="26dp"
            android:gravity="center"
            android:orientation="vertical"
            android:focusable="true"
            android:clickable="true"
            android:background="@drawable/selector_tv_btn">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_home_live"
                android:focusable="false" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:text="直播" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnSearch"
            android:layout_width="110dp"
            android:layout_height="118dp"
            android:layout_marginEnd="26dp"
            android:gravity="center"
            android:orientation="vertical"
            android:focusable="true"
            android:clickable="true"
            android:background="@drawable/selector_tv_btn">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_home_search"
                android:focusable="false" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:text="搜索" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnCollect"
            android:layout_width="110dp"
            android:layout_height="118dp"
            android:layout_marginEnd="26dp"
            android:gravity="center"
            android:orientation="vertical"
            android:focusable="true"
            android:clickable="true"
            android:background="@drawable/selector_tv_btn">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_home_keep"
                android:focusable="false" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:text="收藏" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnHistory"
            android:layout_width="110dp"
            android:layout_height="118dp"
            android:layout_marginEnd="26dp"
            android:gravity="center"
            android:orientation="vertical"
            android:focusable="true"
            android:clickable="true"
            android:background="@drawable/selector_tv_btn">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_home_history"
                android:focusable="false" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:text="历史" />

        </LinearLayout>

    </LinearLayout>

    <!--
      内容区：对齐原版 HomeActivity 的 ViewPager 结构。
      原版 pager 一页只显示一页（page0=首页推荐，page1..N=各分类），结构上不可能叠屏。
      这里用 FrameLayout 承载两页，homeContent 与 mainBody 二选一，杜绝「首页入口行 + 二级页」拼屏。
    -->
    <FrameLayout
        android:id="@+id/contentPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 第 0 页：首页（历史记录 + 更新推荐） -->
        <LinearLayout
            android:id="@+id/homeContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/quickRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/quickLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="6dp"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:text="历史记录 · 点击续播" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/quickList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/recommendRow"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/recommendLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="44dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="8dp"
                    android:textColor="@android:color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04"
                    android:text="更新推荐" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recommendList"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false" />

            </LinearLayout>

        </LinearLayout>

        <!-- 第 1 页：点播分类页（原版 VodFragment） -->
        <LinearLayout
            android:id="@+id/mainBody"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/catList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:clipToPadding="false" />

            <HorizontalScrollView
                android:id="@+id/filterRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/filterList"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/labelVod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="44dp"
                android:paddingTop="8dp"
                android:paddingBottom="4dp"
                android:textColor="#B0FFFFFF"
                android:textSize="14sp"
                android:text="影片" />

            <TextView
                android:id="@+id/tvEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="18dp"
                android:gravity="center"
                android:textColor="#90FFFFFF"
                android:textSize="16sp"
                android:visibility="gone"
                android:text="" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/vodList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
