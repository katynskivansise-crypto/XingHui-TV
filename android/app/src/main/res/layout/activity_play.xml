<?xml version="1.0" encoding="utf-8"?>
<!-- 播放页：全屏播放器 + 返回 + 片名 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black" />

    <TextView
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="14dp"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:focusable="true"
        android:clickable="true"
        android:background="@drawable/selector_tv_btn"
        android:text="← 返回" />

    <!-- 顶部控制：上/下集 + 倍速 + 缩放（对齐原项目 control.prev/next/speed/scale） -->
    <LinearLayout
        android:id="@+id/controlPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:orientation="vertical"
        android:padding="6dp"
        android:background="#66000000">

        <TextView
            android:id="@+id/btnPrev"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:focusable="true"
            android:clickable="true"
            android:background="@drawable/selector_tv_btn"
            android:text="上一集" />

        <TextView
            android:id="@+id/btnNext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:focusable="true"
            android:clickable="true"
            android:background="@drawable/selector_tv_btn"
            android:text="下一集" />

        <TextView
            android:id="@+id/btnSpeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:focusable="true"
            android:clickable="true"
            android:background="@drawable/selector_tv_btn"
            android:text="倍速 1.0x" />

        <TextView
            android:id="@+id/btnScale"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:focusable="true"
            android:clickable="true"
            android:background="@drawable/selector_tv_btn"
            android:text="缩放 等比" />

        <TextView
            android:id="@+id/btnQuality"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:focusable="true"
            android:clickable="true"
            android:background="@drawable/selector_tv_btn"
            android:text="清晰度 自动"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 解析源（对齐原版 view_control_vod.xml 的那一行 parse）：有解析配置且本站没给 playUrl 时才显示。
         原版是控制条最顶部的横向列表，我们控制条在右上角，这里放在底部、片名上方，横向可滚动。 -->
    <HorizontalScrollView
        android:id="@+id/parseBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="44dp"
        android:background="#66000000"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/parseRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/playTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:padding="12dp"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:background="#66000000"
        android:text="播放中" />

</FrameLayout>
