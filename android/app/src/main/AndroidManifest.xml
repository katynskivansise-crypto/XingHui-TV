<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 配置·中心的三类功能落盘位置不同，权限要求也不同：
         网盘线程 / GO 代理版本 → <filesDir>/Pizazz/config.json，应用私有目录，不需要任何权限；
         Cookie / Token          → /sdcard/TVBox/*.txt，走外部存储
                                   （spider 的 merge/m/k.b(String) = new File(getExternalStorageDirectory(), "TVBox")）。
         少了这两条就是 EACCES：界面上"输入框填了、提示保存成功"，文件其实一个字都没写进去。
         targetSdk 34 在 API 25 设备上仍然按运行时权限模型走，所以还得在代码里动态申请。 -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.TVBox">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 站点管理 -->
        <activity
            android:name=".SitesActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Black.NoTitleBar" />

        <!-- 设置 -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Black.NoTitleBar" />

        <!-- 详情 -->
        <activity
            android:name=".DetailActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Black.NoTitleBar" />

        <!-- 播放 -->
        <activity
            android:name=".PlayActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.Black.NoTitleBar" />

        <!-- 搜索 -->
        <activity
            android:name=".SearchActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Black.NoTitleBar" />

        <!-- 直播 -->
        <activity
            android:name=".LiveActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Black.NoTitleBar" />

        <!-- 历史记录 -->
        <activity
            android:name=".HistoryActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Black.NoTitleBar" />

        <!-- 收藏 -->
        <activity
            android:name=".CollectActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Black.NoTitleBar" />
    </application>

</manifest>
