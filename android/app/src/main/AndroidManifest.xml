<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- ★ ACCESS_WIFI_STATE 是配置·中心能否点击的硬前提。
         spider 的 merge/m/G.<init> 里第 31~41 条指令：
             getSystemService("wifi") → WifiManager.getConnectionInfo() → WifiInfo.getIpAddress()
         用途是把局域网 IP 拼进「远程输入」的推送地址（?do=push&operate=web）。
         没有这条权限时 getConnectionInfo() 直接抛 SecurityException，G 的单例构造失败，
         持有它的 G$a.<clinit> 随之失败，之后凡是点配置卡片都抛
         NoClassDefFoundError: com.github.catvod.spider.merge.m.G$a ——
         界面上就是"配置有内容，一点就闪退/什么也弹不出来"。
         这不是我们能绕的：G 是 spider 自绘弹窗的唯一入口。 -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Init.checkPermission 的清单里逐条列了 CHANGE_WIFI_STATE，虽然 getConnectionInfo()
         只需要 ACCESS_WIFI_STATE，但声明缺项会让它那次批量请求返回被拒状态 -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <!-- 原版 TVBox 就带这条；spider 里做网络状态判断（I.f()）要用 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 配置·中心的三类功能落盘位置不同，权限要求也不同：
         网盘线程 / GO 代理版本 → <filesDir>/Pizazz/config.json，应用私有目录，不需要任何权限；
         Cookie / Token          → /sdcard/TVBox 下的 quark_cookie.txt 等文本文件，走外部存储
                                   （spider 的 merge/m/k.b(String) = new File(getExternalStorageDirectory(), "TVBox")）。
         少了这两条就是 EACCES：界面上"输入框填了、提示保存成功"，文件其实一个字都没写进去。
         targetSdk 34 在 API 25 设备上仍然按运行时权限模型走，所以还得在代码里动态申请。 -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <!-- 原版也声明了这条；配置·中心「综合配置」的 update 项要用 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 不写 extractNativeLibs：走 mmap 直读 APK 内的 so，装完不会额外落一份副本。
         43.6MB 的 so 若解压，磁盘总占用反而多出 20MB 左右。
         AGP 8.5.2 的 useLegacyPackaging 默认 false，so 以 Stored 方式存放，前提成立 -->
    <application
        android:name=".XingHuiApp"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.TVBox">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 站点管理 -->
        <activity
            android:name=".SitesActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Black.NoTitleBar" />

        <!-- 设置 -->
        <activity
            android:name=".SettingsPlayerActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Black.NoTitleBar" />

        <activity
            android:name=".SettingsCustomActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Black.NoTitleBar" />

        <activity
            android:name=".SettingsDanmuActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Black.NoTitleBar" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Black.NoTitleBar" />

        <!-- 详情 -->
        <activity
            android:name=".DetailActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode|density|colorMode"
            android:exported="false"
            android:theme="@android:style/Theme.Black.NoTitleBar" />

        <!-- 播放 -->
        <!-- 不能给 singleTask：复用实例但没实现 onNewIntent 时，第二次进播放页拿到的
             还是上一次的 Intent，会播成上一部片。另外必须吃 configChanges，
             否则 HDMI 分辨率/HDR 模式切换会重建 Activity，mpv 被销毁重来、进度丢失 -->
        <activity
            android:name=".PlayActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode|density|colorMode"
            android:theme="@style/Theme.TVBox" />

        <!-- 搜索 -->
        <activity
            android:name=".SearchActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Black.NoTitleBar" />

        <!-- 直播 -->
        <activity
            android:name=".LiveActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Black.NoTitleBar" />

        <!-- 历史记录 -->
        <activity
            android:name=".HistoryActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Black.NoTitleBar" />

        <!-- 收藏 -->
        <activity
            android:name=".CollectActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Black.NoTitleBar" />
    </application>

</manifest>
